@using System.Globalization
@using L4D2PlayStats.Core.Auth
@using L4D2PlayStats.Core.Infrastructure.Options
@using L4D2PlayStats.Core.Skins
@using L4D2PlayStats.Core.Skins.Enums
@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.Models
@using L4D2PlayStats.Web.PageMetadata
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Web.Models.SkinsModel
@inject IViewLocalizer Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer
@inject ICurrentUser CurrentUser
@inject IAppOptionsWraper AppOptions

@{
    ViewData["PageMetadata"] = new SkinsPageMetadata(Model, SharedLocalizer);
    var light = Context.Request.Cookies["theme"] == "light";
    var copyIcon = light ? "copy-light.png" : "copy-dark.png";
    var culture = CultureInfo.CurrentUICulture;
    var weaponNames = SkinsModel.WeaponResourceKeys.ToDictionary(pair => pair.Key, pair => Localizer[pair.Value].Value);
    var wallet = Model.Wallet;
    var season = SkinSeason.Current;
    var authors = Model.Skins
        .Where(skin => !string.IsNullOrEmpty(skin.Author.Name))
        .GroupBy(skin => skin.Author.CommunityId)
        .Select(group => (Author: group.First().Author, Skins: group.OrderBy(skin => skin.Title.Get(culture), StringComparer.CurrentCultureIgnoreCase).ToList()))
        .OrderBy(entry => entry.Author.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToList();
    var loginUrl = Url.Action("Login", "Account", new { returnUrl = Url.Action("Index", "Skins") });
}

@section Styles {
    <style>
        .sk-hero {
            margin: 10px 0 20px;
            padding: 26px 30px 22px;
            border: 1px solid rgba(128, 128, 128, .25);
            border-radius: 6px;
            background: linear-gradient(135deg, rgba(240, 173, 78, .14), rgba(176, 106, 224, .07) 55%, rgba(128, 128, 128, .03));
        }

        .sk-kicker {
            display: inline-block;
            margin-bottom: 8px;
            font-size: 12px;
            font-weight: bold;
            letter-spacing: .08em;
            text-transform: uppercase;
            opacity: .75;
        }

        .sk-hero h1 {
            margin: 0 0 8px;
            font-size: 36px;
            font-weight: bold;
        }

        .sk-hero .lead {
            max-width: 780px;
            margin-bottom: 16px;
        }

        .sk-howto {
            display: flex;
            flex-wrap: wrap;
            margin: 0 -6px 12px;
        }

            .sk-howto > div {
                flex: 1 1 220px;
                margin: 6px;
                padding: 12px 14px;
                border: 1px solid rgba(128, 128, 128, .3);
                border-radius: 4px;
                background: rgba(128, 128, 128, .06);
                font-size: 13px;
            }

            .sk-howto strong {
                display: block;
                margin-bottom: 4px;
            }

            .sk-howto code,
            .sk-command code,
            .sk-message code {
                border: 1px solid rgba(128, 128, 128, .3);
                background: rgba(128, 128, 128, .12);
                color: inherit;
            }

        .sk-wallet {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            padding: 12px 16px;
            border: 1px solid rgba(240, 173, 78, .55);
            border-radius: 4px;
            background: rgba(240, 173, 78, .08);
        }

        .sk-wallet-main {
            flex: 1 1 260px;
        }

        .sk-wallet-balance {
            font-size: 22px;
        }

        .sk-wallet-details {
            font-size: 12px;
            opacity: .8;
        }

        .sk-wallet .btn {
            margin: 6px 0 6px 12px;
        }

        .sk-wallet-warning {
            border-color: rgba(217, 83, 79, .55);
            background: rgba(217, 83, 79, .08);
        }

        .sk-banner {
            display: flex;
            max-width: 780px;
            margin-bottom: 12px;
            padding: 12px 16px;
            border: 1px solid rgba(92, 184, 92, .55);
            border-left: 4px solid #5cb85c;
            border-radius: 4px;
            background: rgba(92, 184, 92, .1);
        }

            .sk-banner .glyphicon {
                margin: 3px 12px 0 0;
                font-size: 18px;
                color: #5cb85c;
            }

            .sk-banner p {
                margin: 4px 0 0;
            }

        .sk-banner-info {
            border-color: rgba(91, 192, 222, .55);
            border-left-color: #5bc0de;
            background: rgba(91, 192, 222, .1);
        }

            .sk-banner-info .glyphicon {
                color: #5bc0de;
            }

        .sk-credits {
            margin: 12px 0 0;
            font-size: 12px;
            opacity: .75;
        }

        .sk-tabs {
            margin-bottom: 14px;
        }

            .sk-tabs > li > a {
                font-size: 15px;
                font-weight: bold;
            }

        .sk-toolbar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            margin-bottom: 16px;
        }

            .sk-toolbar label {
                margin: 0 8px 8px 0;
                font-weight: normal;
                cursor: pointer;
            }

            .sk-toolbar select {
                width: auto;
                min-width: 180px;
                margin: 0 16px 8px 0;
            }

        .sk-rarity {
            margin-bottom: 26px;
        }

        .sk-rarity-header {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 2px solid var(--sk-rarity-color);
        }

            .sk-rarity-header h3 {
                flex: 1;
                margin: 0;
                color: var(--sk-rarity-color);
                font-size: 20px;
                font-weight: bold;
            }

        .sk-count {
            font-size: 12px;
            opacity: .75;
            white-space: nowrap;
        }

        .sk-rarity-legendary {
            --sk-rarity-color: #f0ad4e;
        }

        .sk-rarity-epic {
            --sk-rarity-color: #b06ae0;
        }

        .sk-rarity-rare {
            --sk-rarity-color: #4d9de0;
        }

        .sk-rarity-uncommon {
            --sk-rarity-color: #5cb85c;
        }

        .sk-rarity-common {
            --sk-rarity-color: #9e9e9e;
        }

        .sk-grid {
            display: flex;
            flex-wrap: wrap;
        }

            .sk-grid:before,
            .sk-grid:after {
                display: none;
            }

        .sk-col {
            display: flex;
            margin-bottom: 14px;
        }

        .sk-card {
            display: flex;
            flex-direction: column;
            width: 100%;
            overflow: hidden;
            border: 1px solid rgba(128, 128, 128, .3);
            border-top: 3px solid var(--sk-rarity-color);
            border-radius: 6px;
            background: rgba(128, 128, 128, .05);
            cursor: pointer;
            transition: transform .15s ease, box-shadow .15s ease;
        }

            .sk-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(0, 0, 0, .25);
            }

        .sk-legendary-card {
            box-shadow: 0 0 12px rgba(240, 173, 78, .25);
        }

        .sk-owned {
            border-color: rgba(98, 196, 98, .6);
            border-top-color: var(--sk-rarity-color);
        }

        .sk-thumb {
            position: relative;
            display: block;
            background: #111;
        }

            .sk-thumb img {
                display: block;
                width: 100%;
                aspect-ratio: 1 / 1;
                object-fit: cover;
            }

            .sk-thumb .sk-shot {
                position: absolute;
                top: 0;
                left: 0;
                opacity: 0;
                transition: opacity .5s ease;
                pointer-events: none;
            }

                .sk-thumb .sk-shot.active {
                    opacity: 1;
                }

        .sk-weapon,
        .sk-status,
        .sk-price-tag {
            position: absolute;
            z-index: 2;
            font-size: 11px;
        }

        .sk-weapon {
            top: 8px;
            left: 8px;
            background: rgba(0, 0, 0, .75);
            color: #fff;
        }

        .sk-status {
            top: 8px;
            right: 8px;
        }

        .sk-price-tag {
            right: 8px;
            bottom: 8px;
            padding: 4px 8px;
            border-radius: 12px;
            background: rgba(0, 0, 0, .8);
            color: #fff;
            font-size: 13px;
            font-weight: bold;
        }

        .sk-body {
            display: flex;
            flex: 1;
            flex-direction: column;
            padding: 10px 12px 12px;
        }

        .sk-title {
            margin: 0 0 2px;
            overflow: hidden;
            font-size: 14px;
            font-weight: bold;
            line-height: 1.35;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .sk-author {
            margin-bottom: 2px;
            overflow: hidden;
            font-size: 12px;
            white-space: nowrap;
            text-overflow: ellipsis;
            opacity: .85;
        }

        .sk-modal-author {
            margin-bottom: 10px;
        }

        .sk-authors {
            display: flex;
            flex-wrap: wrap;
            margin: 0 -6px;
        }

            .sk-authors > div {
                flex: 1 1 260px;
                margin: 6px;
                padding: 10px 14px;
                border: 1px solid rgba(128, 128, 128, .3);
                border-radius: 4px;
                background: rgba(128, 128, 128, .05);
            }

            .sk-authors strong {
                display: block;
                overflow: hidden;
                white-space: nowrap;
                text-overflow: ellipsis;
            }

            .sk-authors small {
                display: block;
                margin-top: 4px;
                opacity: .8;
            }

        .sk-rarity-name {
            margin-bottom: 10px;
            color: var(--sk-rarity-color);
            font-size: 12px;
            font-weight: bold;
        }

        .sk-actions {
            margin-top: auto;
        }

            .sk-actions .btn {
                font-weight: bold;
            }

        .sk-missing {
            display: block;
            margin-top: 4px;
            font-size: 11px;
            text-align: center;
            opacity: .75;
        }

        .sk-empty {
            padding: 30px 0;
            text-align: center;
            opacity: .75;
        }

        .sk-modal-image {
            display: block;
            margin-bottom: 12px;
        }

            .sk-modal-image img {
                display: block;
                width: 100%;
                max-height: 420px;
                border-radius: 4px;
                background: #111;
                object-fit: contain;
            }

        .sk-gallery {
            margin-bottom: 15px;
        }

        .sk-author-notice-open {
            padding-left: 0;
            opacity: .7;
        }

            .sk-author-notice-open:hover,
            .sk-author-notice-open:focus {
                opacity: 1;
            }

        .sk-author-notice .lead {
            font-size: 16px;
        }

        .sk-author-notice-actions .btn {
            margin: 4px 6px 4px 0;
        }

            .sk-gallery .sk-gallery-main {
                margin-bottom: 8px;
                cursor: zoom-in;
            }

                .sk-gallery .sk-gallery-main img {
                    max-height: none;
                    aspect-ratio: 16 / 9;
                    object-fit: cover;
                    transition: opacity .25s ease;
                }

                    .sk-gallery .sk-gallery-main img.loading {
                        opacity: .35;
                    }

        .sk-gallery-thumbs {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 6px;
        }

        .sk-gallery-thumb {
            padding: 0;
            border: 2px solid transparent;
            border-radius: 4px;
            background: #111;
            opacity: .65;
            overflow: hidden;
            transition: opacity .2s ease, border-color .2s ease;
        }

            .sk-gallery-thumb:hover,
            .sk-gallery-thumb:focus {
                opacity: 1;
                outline: none;
            }

            .sk-gallery-thumb.active {
                border-color: var(--sk-rarity-color, #f0ad4e);
                opacity: 1;
            }

            .sk-gallery-thumb img {
                display: block;
                width: 100%;
                aspect-ratio: 16 / 9;
                object-fit: cover;
            }

        @@media (max-width: 480px) {
            .sk-gallery-thumbs {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        .sk-modal-tags {
            margin: 0 0 10px;
        }

            .sk-modal-tags .label {
                display: inline-block;
                margin: 0 6px 4px 0;
                font-size: 12px;
            }

        .sk-modal-rarity {
            background: var(--sk-rarity-color);
        }

        .sk-modal-price {
            margin-bottom: 12px;
            font-size: 22px;
            font-weight: bold;
        }

        .sk-modal-desc {
            font-size: 14px;
            line-height: 1.5;
        }

        .sk-modal-original {
            font-size: 12px;
            opacity: .65;
        }

        .sk-modal-actions {
            margin: 14px 0;
        }

        .sk-command-label {
            margin-bottom: 3px;
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
            opacity: .65;
        }

        .sk-command {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }

            .sk-command code {
                flex: 1;
                padding: 5px 7px;
                overflow: hidden;
                font-size: 12px;
                white-space: nowrap;
                text-overflow: ellipsis;
            }

            .sk-command .icon-copy {
                width: 18px;
                height: 18px;
                margin: 0 0 0 8px;
            }

        .sk-workshop .glyphicon {
            margin-right: 4px;
        }

        .sk-message p:last-child {
            margin-bottom: 0;
        }

        .sk-message .sk-notice {
            padding: 10px 12px;
            border-left: 3px solid #5bc0de;
            background: rgba(91, 192, 222, .1);
        }

        .sk-use-table td:first-child {
            white-space: nowrap;
        }

        @@media screen and (max-width: 700px) {
            .sk-hero {
                padding: 20px 16px;
            }

                .sk-hero h1 {
                    font-size: 28px;
                }

            .sk-wallet .btn {
                margin-left: 0;
            }
        }
    </style>
}

@Html.AntiForgeryToken()

<div class="sk-hero">
    <span class="sk-kicker">@Localizer["Kicker"]</span>
    <h1>@SharedLocalizer["Skins"]</h1>
    <p class="lead">@Localizer["Lead"]</p>

    <div class="sk-banner sk-banner-info">
        <span class="glyphicon glyphicon-calendar"></span>
        <div>
            <strong>@Localizer["SeasonTitle"]</strong>
            <p>@string.Format(Localizer["SeasonText"].Value, season.LastDay.ToString("d", culture), season.DaysLeft.ToString("N0", culture))</p>
        </div>
    </div>

    <div class="sk-howto">
        <div>
            <strong>@Localizer["HowToEarnTitle"]</strong>
            @Html.Raw(Localizer["HowToEarn"].Value)
        </div>
        <div>
            <strong>@Localizer["HowToBuyTitle"]</strong>
            @Html.Raw(Localizer["HowToBuy"].Value)
        </div>
        <div>
            <strong>@Localizer["HowToSwitchTitle"]</strong>
            @Html.Raw(Localizer["HowToSwitch"].Value)
        </div>
    </div>

    <p>
        <button type="button" class="btn btn-info sk-use-open">
            <span class="glyphicon glyphicon-question-sign"></span> @Localizer["UseButton"]
        </button>
    </p>

    @if (!Model.LoggedIn)
    {
        <div class="sk-wallet">
            <div class="sk-wallet-main">@Localizer["LoginToBuy"]</div>
            <a class="btn btn-warning" href="@loginUrl">@Localizer["LoginButton"]</a>
        </div>
    }
    else if (wallet == null)
    {
        <div class="sk-wallet sk-wallet-warning">
            <div class="sk-wallet-main">@Localizer["WalletUnavailable"]</div>
        </div>
    }
    else
    {
        <div class="sk-wallet">
            <div class="sk-wallet-main">
                <div class="sk-wallet-balance">@Html.Raw(string.Format(Localizer["WalletBalance"].Value, wallet.Balance.ToString("N0", culture)))</div>
                <div class="sk-wallet-details">@string.Format(Localizer["WalletDetails"].Value, wallet.MvpSiDamage.ToString("N0", culture), wallet.MvpCommon.ToString("N0", culture), wallet.Stars.ToString("N0", culture), wallet.Spent.ToString("N0", culture))</div>
            </div>
        </div>
    }

    <p class="sk-credits">@Localizer["Credits"]</p>
</div>

@{
    async Task RenderActions(Skin skin, bool block)
    {
        var title = skin.Title.Get(culture);
        var blockClass = block ? "btn-block" : string.Empty;

        if (!Model.LoggedIn)
        {
            <a class="btn btn-default btn-sm @blockClass sk-action" href="@loginUrl">@Localizer["LoginButton"]</a>
            return;
        }

        if (Model.IsEquipped(skin))
        {
            <button type="button" class="btn btn-default btn-sm @blockClass sk-action sk-unequip" data-weapon="@skin.Weapon" data-weapon-name="@weaponNames[skin.Weapon]">
                <span class="glyphicon glyphicon-repeat"></span> @Localizer["Unequip"]
            </button>
            return;
        }

        if (Model.Owns(skin))
        {
            <button type="button" class="btn btn-success btn-sm @blockClass sk-action sk-equip" data-skin="@skin.Id" data-title="@title" data-weapon-name="@weaponNames[skin.Weapon]">
                <span class="glyphicon glyphicon-ok"></span> @Localizer["Equip"]
            </button>
            return;
        }

        if (Model.Wallet == null)
        {
            <button type="button" class="btn btn-default btn-sm @blockClass sk-action" disabled>@string.Format(Localizer["BuyFor"].Value, skin.Price.ToString("N0", culture))</button>
            return;
        }

        if (!Model.CanAfford(skin))
        {
            <button type="button" class="btn btn-default btn-sm @blockClass sk-action" disabled>@string.Format(Localizer["BuyFor"].Value, skin.Price.ToString("N0", culture))</button>
            <small class="sk-missing">@string.Format(Localizer["MissingStars"].Value, Model.Missing(skin).ToString("N0", culture))</small>
            return;
        }

        <button type="button" class="btn btn-warning btn-sm @blockClass sk-action sk-buy" data-skin="@skin.Id" data-title="@title" data-price="@skin.Price" data-weapon-name="@weaponNames[skin.Weapon]">
            <span class="glyphicon glyphicon-shopping-cart"></span> @string.Format(Localizer["BuyFor"].Value, skin.Price.ToString("N0", culture))
        </button>
    }

    const int ShotCount = 6;

    string ShotsUrl(Skin skin)
    {
        return $"{AppOptions.SkinShotsUrl}/{skin.Id}/";
    }

    async Task RenderDetails(Skin skin)
    {
        var title = skin.Title.Get(culture);
        var description = skin.Description.Get(culture);
        var original = string.Join(" — ", new[] { skin.OriginalTitle, skin.OriginalDescription }.Where(text => !string.IsNullOrWhiteSpace(text)));

        <div class="sk-details hidden">
            <div class="row @SkinsModel.RarityCss(skin.Rarity)">
                @if (skin.HasShots)
                {
                    var shots = ShotsUrl(skin);

                    <div class="col-xs-12">
                        <div class="sk-gallery" data-shots="@shots" data-version="@skin.Shots">
                            <a class="sk-modal-image sk-gallery-main" href="@($"{shots}1.webp?v={skin.Shots}")" data-lity>
                                <img data-shot="1" data-size="" alt="@title"/>
                            </a>
                            <div class="sk-gallery-thumbs">
                                @for (var shot = 1; shot <= ShotCount; shot++)
                                {
                                    <button type="button" class="sk-gallery-thumb @(shot == 1 ? "active" : "")" data-shot="@shot" title="@title (@shot/@ShotCount)">
                                        <img data-shot="@shot" data-size="-thumb" alt="@title (@shot/@ShotCount)"/>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-xs-12 col-sm-5">
                        <a class="sk-modal-image" href="@skin.Image" data-lity>
                            <img src="@skin.Image" alt="@title" loading="lazy"/>
                        </a>
                    </div>
                }
                <div class="col-xs-12 @(skin.HasShots ? "" : "col-sm-7")">
                    <div class="sk-modal-tags">
                        <span class="label sk-modal-rarity">@Localizer[SkinsModel.RarityKey(skin.Rarity)]</span>
                        <span class="label label-default">@weaponNames[skin.Weapon]</span>
                        @if (Model.IsEquipped(skin))
                        {
                            <span class="label label-success">
                                <span class="glyphicon glyphicon-ok"></span> @Localizer["Equipped"]
                            </span>
                        }
                        else if (Model.Owns(skin))
                        {
                            <span class="label label-info">@Localizer["Owned"]</span>
                        }
                    </div>
                    <div class="sk-modal-price">@skin.Price.ToString("N0", culture) ⭐</div>
                    @if (!string.IsNullOrEmpty(skin.Author.Name))
                    {
                        <p class="sk-modal-author">
                            <b>@Localizer["Author"]:</b>
                            <a href="@skin.Author.ProfileUrl" target="_blank" rel="noopener">
                                <span class="glyphicon glyphicon-user"></span> @skin.Author.Name
                            </a>
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(description))
                    {
                        <p class="sk-modal-desc">@description</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(original))
                    {
                        <p class="sk-modal-original">
                            <b>@Localizer["Original"]:</b> @original
                        </p>
                    }
                    <div class="sk-modal-actions">
                        @{ await RenderActions(skin, true); }
                    </div>
                    @if (Model.Owns(skin))
                    {
                        <div class="sk-command-label">@Localizer["ChatCommand"]</div>
                        <div class="sk-command">
                            <code>@skin.Command</code>
                            <img src="~/imgs/icons/@copyIcon" alt="@SharedLocalizer["CopyText"]" class="icon-copy"
                                 data-toggle="popover" data-placement="top" data-content="@SharedLocalizer["TextCopied"]"
                                 onclick="copyTextToClipboard('@skin.Command', this)"/>
                        </div>
                    }
                    <a class="btn btn-default btn-sm btn-block sk-workshop" href="@skin.WorkshopUrl" target="_blank" rel="noopener">
                        <span class="glyphicon glyphicon-new-window"></span> @Localizer["ViewOnWorkshop"]
                    </a>
                    @if (CurrentUser.IsAdmin)
                    {
                        <button type="button" class="btn btn-success btn-sm btn-block sk-admin-gift" data-skin="@skin.Id">
                            <span class="glyphicon glyphicon-gift"></span> @Localizer["AdminGift"]
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    async Task RenderCard(Skin skin, bool anchor)
    {
        var title = skin.Title.Get(culture);
        var owned = Model.Owns(skin);
        var equipped = Model.IsEquipped(skin);

        <div class="col-xs-6 col-sm-4 col-md-3 sk-col sk-item @SkinsModel.RarityCss(skin.Rarity)"
             data-weapon="@skin.Weapon" data-rarity="@skin.Rarity" data-affordable="@(owned || Model.CanAfford(skin) ? 1 : 0)">
            <div class="sk-card sk-open @(owned ? "sk-owned" : "") @(skin.Rarity == SkinRarity.Legendary ? "sk-legendary-card" : "")" id="@(anchor ? $"skin-{skin.Id}" : null)" data-title="@title" data-skin="@skin.Id" data-workshop="@skin.WorkshopUrl">
                @{ await RenderDetails(skin); }
                <a class="sk-thumb" href="#skin-@skin.Id" data-shots="@(skin.HasShots ? ShotsUrl(skin) : null)" data-version="@(skin.HasShots ? skin.Shots : null)">
                    <img src="@skin.Image" alt="@title" loading="lazy"/>
                    <span class="label sk-weapon">@weaponNames[skin.Weapon]</span>
                    @if (equipped)
                    {
                        <span class="label label-success sk-status">
                            <span class="glyphicon glyphicon-ok"></span> @Localizer["Equipped"]
                        </span>
                    }
                    else if (owned)
                    {
                        <span class="label label-info sk-status">@Localizer["Owned"]</span>
                    }
                    <span class="sk-price-tag">@skin.Price.ToString("N0", culture) ⭐</span>
                </a>
                <div class="sk-body">
                    <h4 class="sk-title" title="@title">@title</h4>
                    @if (!string.IsNullOrEmpty(skin.Author.Name))
                    {
                        <div class="sk-author" title="@skin.Author.Name">
                            @Localizer["By"] <a href="@skin.Author.ProfileUrl" target="_blank" rel="noopener">@skin.Author.Name</a>
                        </div>
                    }
                    <div class="sk-rarity-name">@Localizer[SkinsModel.RarityKey(skin.Rarity)]</div>
                    <div class="sk-actions">
                        @{ await RenderActions(skin, true); }
                    </div>
                </div>
            </div>
        </div>
    }
}

