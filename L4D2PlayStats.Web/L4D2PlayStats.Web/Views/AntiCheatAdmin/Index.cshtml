@using System.Globalization
@using L4D2PlayStats.Core.AntiCheatAccess
@using L4D2PlayStats.Core.AntiCheatAccess.Enums
@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.Models
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Web.Models.AntiCheatAdminModel
@inject IViewLocalizer Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer

@{
    ViewData["Title"] = SharedLocalizer["AntiCheatAdmin"].Value;
    var culture = CultureInfo.CurrentUICulture;
    var pagination = PaginationModel.Of(Model.Players, number => Url.Action("Index", "AntiCheatAdmin", new { list = Model.ShownListName, q = Model.Query, page = number })!);
    var whitelistShown = Model.ShownList == AntiCheatAccessList.Whitelist;
    var listTitle = whitelistShown ? Localizer["ListWhitelistTitle"] : Localizer["ListRequiredTitle"];
    var listHelp = whitelistShown ? Localizer["ListWhitelistHelp"] : Localizer["ListRequiredHelp"];
    var otherListName = (Model.OtherList == AntiCheatAccessList.Whitelist ? Localizer["ListWhitelistName"] : Localizer["ListRequiredName"]).Value;
    var updatedAt = Model.Access.UpdatedAtUtc?.ToLocalTime().ToString("g", culture);
    var updatedFrom = Model.Access.UpdatedFrom == nameof(AntiCheatAccessSource.Game) ? Localizer["FromGame"].Value : Localizer["FromSite"].Value;
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    <style>
        .aca-modes {
            display: flex;
            flex-wrap: wrap;
            margin: 0 -6px 6px;
        }

        .aca-mode {
            display: flex;
            flex: 1 1 280px;
            margin: 0 6px 8px;
            padding: 12px 14px;
            border: 1px solid rgba(128, 128, 128, .3);
            border-radius: 6px;
            cursor: pointer;
            font-weight: normal;
        }

            .aca-mode.aca-selected {
                border-color: #3c9a5f;
                background: rgba(60, 154, 95, .12);
            }

            .aca-mode input {
                margin: 3px 10px 0 0;
                flex: 0 0 auto;
            }

            .aca-mode strong {
                display: block;
            }

            .aca-mode small {
                display: block;
                opacity: .75;
            }

        .aca-mode-footer {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            margin-bottom: 18px;
        }

            .aca-mode-footer small {
                flex: 1 1 240px;
                margin: 0 12px 6px 0;
                opacity: .75;
            }

        .aca-list-header {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            margin: 6px 0 10px;
        }

            .aca-list-header h4 {
                flex: 1 1 auto;
                margin: 0 12px 4px 0;
                font-weight: bold;
            }

        .aca-preview {
            display: flex;
            align-items: center;
            min-height: 52px;
            margin-top: 8px;
        }

            .aca-preview img {
                width: 48px;
                height: 48px;
                margin-right: 10px;
                border-radius: 50%;
                flex: 0 0 auto;
            }

            .aca-preview strong,
            .aca-preview small {
                display: block;
            }

            .aca-preview small {
                opacity: .75;
            }

        .aca-details-avatar {
            width: 96px !important;
            height: 96px !important;
            border-radius: 50% !important;
        }
    </style>
}

<div class="admin-header">
    <h3>@SharedLocalizer["AntiCheatAdmin"]</h3>
    <button type="button" class="btn btn-primary aca-add">
        <span class="glyphicon glyphicon-plus"></span> @Localizer["AddPlayer"]
    </button>
</div>

<p class="text-muted">@Localizer["Lead"]</p>

<h4>@Localizer["ModeTitle"]</h4>
<div class="aca-modes">
    <label class="aca-mode @(Model.Mode == AntiCheatAccessMode.Everyone ? "aca-selected" : "")">
        <input type="radio" name="aca-mode" value="@AntiCheatAccessNames.Everyone" @(Model.Mode == AntiCheatAccessMode.Everyone ? "checked" : "")/>
        <span>
            <strong>@Localizer["ModeEveryone"]</strong>
            <small>@Localizer["ModeEveryoneHelp"]</small>
        </span>
    </label>
    <label class="aca-mode @(Model.Mode == AntiCheatAccessMode.Listed ? "aca-selected" : "")">
        <input type="radio" name="aca-mode" value="@AntiCheatAccessNames.Listed" @(Model.Mode == AntiCheatAccessMode.Listed ? "checked" : "")/>
        <span>
            <strong>@Localizer["ModeListed"]</strong>
            <small>@Localizer["ModeListedHelp"]</small>
        </span>
    </label>
</div>
<div class="aca-mode-footer">
    <small class="aca-mode-status">
        @if (!Model.Access.ModeSaved)
        {
            @Localizer["ModeNotSaved"]
        }
        else if (!string.IsNullOrWhiteSpace(Model.Access.UpdatedByName) && updatedAt != null)
        {
            @string.Format(Localizer["ModeUpdated"].Value, Model.Access.UpdatedByName, updatedFrom, updatedAt)
        }
    </small>
    <button type="button" class="btn btn-success aca-save-mode" @(Model.Access.ModeSaved ? "disabled" : "")>
        <span class="glyphicon glyphicon-floppy-disk"></span> @Localizer["SaveMode"]
    </button>
</div>
<div class="aca-mode-message"></div>

<div class="aca-list-header">
    <h4>@listTitle</h4>
    <a href="@Url.Action("Index", "AntiCheatAdmin", new { list = Model.OtherListName })">@string.Format(Localizer["ShowOtherList"].Value, otherListName, Model.OtherCount.ToString("N0", culture))</a>
</div>
<p class="text-muted">@listHelp</p>

@if (!Model.ShowingActiveList)
{
    <div class="alert alert-info">
        @Localizer["InactiveList"]
        <a class="alert-link" href="@Url.Action("Index", "AntiCheatAdmin")">@Localizer["BackToActive"]</a>
    </div>
}

<div class="admin-stats">
    <div>
        <strong>@Model.ShownCount.ToString("N0", culture)</strong>
        <small>@Localizer["StatPlayers"]</small>
    </div>
</div>

<form method="get" class="admin-filters">
    <input type="hidden" name="list" value="@Model.ShownListName"/>
    <input type="text" name="q" value="@Model.Query" class="form-control admin-search" placeholder="@Localizer["SearchPlaceholder"]"/>
    <button type="submit" class="btn btn-default">
        <span class="glyphicon glyphicon-search"></span> @SharedLocalizer["Search"]
    </button>
    @if (!string.IsNullOrEmpty(Model.Query))
    {
        <a class="btn btn-link" href="@Url.Action("Index", "AntiCheatAdmin", new { list = Model.ShownListName })">@Localizer["ClearFilters"]</a>
    }
</form>

<div class="admin-list">
    @if (Model.Players.Items.Count == 0)
    {
        <div class="admin-empty">@Localizer["NoPlayers"]</div>
    }
    @foreach (var player in Model.Players.Items)
    {
        var addedAt = player.CreatedAtUtc.ToLocalTime().ToString("g", culture);
        var addedFrom = player.AddedFrom == nameof(AntiCheatAccessSource.Game) ? Localizer["FromGame"].Value : Localizer["FromSite"].Value;
        var addedBy = string.IsNullOrWhiteSpace(player.AddedByName) ? addedFrom : string.Format(Localizer["AddedByValue"].Value, player.AddedByName, addedFrom);

        <div class="admin-item aca-player"
             data-community-id="@player.CommunityId" data-name="@player.Name" data-avatar="@player.AvatarUrl" data-steam-id="@player.SteamId"
             data-profile-url="@player.ProfileUrl" data-added-at="@addedAt" data-added-by="@addedBy">
            <img class="admin-avatar" src="@player.AvatarUrl" alt="@player.Name" onerror="imgOnError(this)"/>
            <div class="admin-main">
                <div class="admin-title">@player.Name</div>
                <small>@player.SteamId · @player.CommunityId</small>
            </div>
            <div class="admin-side">
                <strong>@addedAt</strong>
                <small>@addedBy</small>
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("_Pagination", pagination)

<div id="aca-details-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@SharedLocalizer["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@listTitle</h4>
            </div>
            <div class="modal-body">
                <div class="admin-details">
                    <img class="aca-avatar aca-details-avatar" src="" alt="" onerror="imgOnError(this)"/>
                    <dl>
                        <dt>@SharedLocalizer["Player"]</dt>
                        <dd>
                            <a class="aca-player-link" href="#"></a><br/>
                            <small class="aca-ids text-muted"></small><br/>
                            <a class="aca-steam-link" href="#" target="_blank" rel="noopener noreferrer">@Localizer["SteamProfile"]</a>
                        </dd>
                        <dt>@Localizer["AddedAt"]</dt>
                        <dd class="aca-added-at"></dd>
                        <dt>@Localizer["AddedBy"]</dt>
                        <dd class="aca-added-by"></dd>
                    </dl>
                </div>
                <div class="alert alert-warning admin-confirm aca-remove-confirm">@Localizer["ConfirmRemove"]</div>
                <div class="aca-message"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@SharedLocalizer["Close"]</button>
                <button type="button" class="btn btn-danger aca-remove">
                    <span class="glyphicon glyphicon-trash"></span> @Localizer["RemovePlayer"]
                </button>
                <button type="button" class="btn btn-danger aca-remove-yes" style="display: none">@Localizer["ConfirmRemoveButton"]</button>
            </div>
        </div>
    </div>
</div>

<div id="aca-add-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@SharedLocalizer["Close"]">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@string.Format(Localizer["AddTo"].Value, listTitle.Value)</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="aca-add-player">@SharedLocalizer["SteamIdOrProfileUrl"]</label>
                    <div class="input-group">
                        <input type="text" id="aca-add-player" class="form-control" placeholder="76561198000000000" autocomplete="off"/>
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-default aca-pick-player">
                                <span class="glyphicon glyphicon-user"></span> @Localizer["PickPlayer"]
                            </button>
                        </span>
                    </div>
                    <div class="aca-preview"></div>
                </div>
                <div class="aca-add-message"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                <button type="button" class="btn btn-primary aca-add-save" disabled>@SharedLocalizer["Save"]</button>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_PlayerPickerModal")

@section Scripts {
    <script>
        $(function () {
            var shownList = @Json.Serialize(Model.ShownListName);
            var savedMode = @Json.Serialize(Model.Access.ModeSaved ? Model.Mode.ToName() : null);
            var texts = {
                saved: @Json.Serialize(Localizer["Saved"].Value),
                removed: @Json.Serialize(Localizer["Removed"].Value),
                modeSaved: @Json.Serialize(Localizer["ModeSaved"].Value),
                searching: @Json.Serialize(Localizer["LookupSearching"].Value),
                notFound: @Json.Serialize(Localizer["LookupNotFound"].Value),
                known: @Json.Serialize(Localizer["LookupKnown"].Value),
                steam: @Json.Serialize(Localizer["LookupSteam"].Value),
                noName: @Json.Serialize(Localizer["LookupNoName"].Value),
                already: @Json.Serialize(Localizer["AlreadyListed"].Value),
                error: @Json.Serialize(Localizer["ErrorGeneric"].Value)
            };
            var listedIds = @Json.Serialize(Model.Access[Model.ShownList].Select(player => player.CommunityId));

            var selected = null;
            var picked = null;
            var lookupTimer = null;
            var lookupSequence = 0;

            function escapeHtml(text) {
                return $('<div/>').text(text == null ? '' : text).html();
            }

            function message($target, success, text) {
                $target.html('<div class="alert ' + (success ? 'alert-success' : 'alert-danger') + '">' + escapeHtml(text) + '</div>');
            }

            function errorText(xhr) {
                return (xhr.responseJSON && xhr.responseJSON.errorMessage) || texts.error;
            }

            $('input[name="aca-mode"]').on('change', function () {
                var mode = $('input[name="aca-mode"]:checked').val();

                $('.aca-mode').removeClass('aca-selected');
                $(this).closest('.aca-mode').addClass('aca-selected');
                $('.aca-save-mode').prop('disabled', mode === savedMode);
            });

            $('.aca-save-mode').on('click', function () {
                var $button = $(this);
                var mode = $('input[name="aca-mode"]:checked').val();

                $button.prop('disabled', true);

                $.ajax({
                    url: '/api/anti-cheat-access/mode',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ mode: mode })
                }).done(function () {
                    message($('.aca-mode-message'), true, texts.modeSaved);
                    setTimeout(function () { location.href = '@Url.Action("Index", "AntiCheatAdmin")'; }, 900);
                }).fail(function (xhr) {
                    message($('.aca-mode-message'), false, errorText(xhr));
                    $button.prop('disabled', false);
                });
            });

            $('.aca-player').on('click', function () {
                var $item = $(this);
                var $modal = $('#aca-details-modal');
                var profileUrl = $item.data('profile-url');

                selected = { communityId: $item.data('community-id').toString(), name: $item.data('name') };

                $modal.find('.aca-avatar').attr({ src: $item.data('avatar'), alt: selected.name });
                $modal.find('.aca-player-link').text(selected.name).attr('href', '/player/' + encodeURIComponent(selected.communityId));
                $modal.find('.aca-ids').text(($item.data('steam-id') || '') + ' · ' + selected.communityId);
                $modal.find('.aca-steam-link').attr('href', profileUrl || '#').toggle(!!profileUrl);
                $modal.find('.aca-added-at').text($item.data('added-at'));
                $modal.find('.aca-added-by').text($item.data('added-by'));
                $modal.find('.aca-remove-confirm').hide();
                $modal.find('.aca-message').empty();
                $modal.find('.aca-remove').show();
                $modal.find('.aca-remove-yes').hide();
                $modal.find('button').prop('disabled', false);
                $modal.modal('show');
            });

            $('.aca-remove').on('click', function () {
                $('#aca-details-modal .aca-remove-confirm').show();
                $(this).hide();
                $('#aca-details-modal .aca-remove-yes').show();
            });

            $('.aca-remove-yes').on('click', function () {
                var $button = $(this);
                var $message = $('#aca-details-modal .aca-message');

                $button.prop('disabled', true);

                $.ajax({
                    url: '/api/anti-cheat-access/' + shownList + '/' + encodeURIComponent(selected.communityId),
                    type: 'DELETE'
                }).done(function () {
                    message($message, true, texts.removed);
                    setTimeout(function () { location.reload(); }, 900);
                }).fail(function (xhr) {
                    message($message, false, errorText(xhr));
                    $button.prop('disabled', false);
                });
            });

            function showPreview(player) {
                var $preview = $('#aca-add-modal .aca-preview').empty();

                if (!player)
                    return;

                var origin = player.knownOnSite ? texts.known : texts.steam;
                var $info = $('<div></div>');

                $info.append($('<strong></strong>').text(player.name || texts.noName));
                $info.append($('<small></small>').text((player.steamId || '') + ' · ' + player.communityId));
                $info.append($('<small></small>').text(origin));

                $preview.append($('<img alt="" onerror="imgOnError(this)"/>').attr('src', player.avatarUrl || ''));
                $preview.append($info);
            }

            function setPicked(player) {
                picked = player;
                showPreview(player);

                var already = !!player && listedIds.indexOf(player.communityId) >= 0;

                $('#aca-add-modal .aca-add-message').empty();
                if (already)
                    message($('#aca-add-modal .aca-add-message'), false, texts.already);

                $('#aca-add-modal .aca-add-save').prop('disabled', !player || already);
            }

            function lookup(value) {
                var sequence = ++lookupSequence;
                var $preview = $('#aca-add-modal .aca-preview');

                if ($.trim(value) === '') {
                    setPicked(null);
                    return;
                }

                $preview.html('<span class="text-muted">' + escapeHtml(texts.searching) + '</span>');

                $.getJSON('/api/admin/players/lookup', { id: $.trim(value) }).done(function (player) {
                    if (sequence === lookupSequence)
                        setPicked(player);
                }).fail(function () {
                    if (sequence !== lookupSequence)
                        return;

                    setPicked(null);
                    $preview.html('<span class="text-danger">' + escapeHtml(texts.notFound) + '</span>');
                });
            }

            $('.aca-add').on('click', function () {
                $('#aca-add-player').val('');
                setPicked(null);
                $('#aca-add-modal').modal('show');
            });

            $('#aca-add-modal').on('shown.bs.modal', function () {
                $('#aca-add-player').focus();
            });

            $('#aca-add-player').on('input', function () {
                var value = $(this).val();

                $('#aca-add-modal .aca-add-save').prop('disabled', true);
                clearTimeout(lookupTimer);
                lookupTimer = setTimeout(function () { lookup(value); }, 400);
            });

            $('.aca-pick-player').on('click', function () {
                $('#aca-add-modal').one('hidden.bs.modal', function () {
                    PlayerPicker.open(function (player) {
                        if (player) {
                            $('#aca-add-player').val(player.communityId);
                            setPicked({
                                communityId: player.communityId,
                                steamId: player.steamId,
                                name: player.name,
                                avatarUrl: player.avatarUrl,
                                knownOnSite: true
                            });
                        }

                        $('#aca-add-modal').modal('show');
                    });
                }).modal('hide');
            });

            $('.aca-add-save').on('click', function () {
                var $button = $(this);
                var $message = $('#aca-add-modal .aca-add-message');

                if (!picked)
                    return;

                $button.prop('disabled', true);

                $.ajax({
                    url: '/api/anti-cheat-access/' + shownList,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ player: picked.communityId, name: picked.name || null })
                }).done(function () {
                    message($message, true, texts.saved);
                    setTimeout(function () { location.reload(); }, 900);
                }).fail(function (xhr) {
                    message($message, false, errorText(xhr));
                    $button.prop('disabled', false);
                });
            });
        });
    </script>
}
