@using System.Globalization
@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.PageMetadata
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Web.Models.PatentModel
@inject IViewLocalizer Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer

@{
    ViewData["PageMetadata"] = new PatentsPageMetadata(Model, SharedLocalizer);
}

@section Styles {
    <style>
        .patent-skins-button {
            padding: 6px 14px;
            font-weight: bold;
            white-space: nowrap;
        }

            .patent-skins-button .glyphicon {
                margin-right: 4px;
            }

        .patent-skins-title {
            margin: 4px 0 10px;
            font-weight: bold;
        }

        .patent-skins {
            display: flex;
            flex-wrap: wrap;
            margin: 0 -5px 8px;
        }

        .patent-skin {
            display: block;
            width: 120px;
            margin: 0 5px 10px;
            text-align: center;
            text-decoration: none !important;
        }

            .patent-skin img {
                display: block;
                width: 120px;
                height: 120px;
                margin-bottom: 4px;
                border: 1px solid rgba(128, 128, 128, .3);
                border-radius: 4px;
                object-fit: cover;
            }

            .patent-skin span {
                display: block;
                overflow: hidden;
                font-size: 11px;
                white-space: nowrap;
                text-overflow: ellipsis;
            }

            .patent-skin-soon img {
                filter: grayscale(85%);
                opacity: .55;
            }

            .patent-skin .patent-skin-release {
                color: #5bc0de;
                font-weight: bold;
            }
    </style>
}

<h4 class="text-center">@SharedLocalizer["Patents"]</h4>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">@Localizer["UnderstandingPatentSystem"]</h3>
    </div>
    <div class="panel-body">
        <p>
            @Localizer["PatentSystemDescription1"]
        </p>
        <p>
            @Html.Raw(string.Format(Localizer["PatentSystemDescription2"].Value, Model.Config.Win, Math.Abs(Model.Config.Loss), Model.Config.Mvps, Model.Config.MvpsCommon, Model.Config.RageQuit))
        </p>
    </div>
</div>

<table class="table table-striped table-hover table-bordered table-condensed">
    <thead>
    <tr>
        <th class="text-center">@Localizer["Level"]</th>
        <th colspan="2">@Localizer["Description"]</th>
        <th class="text-center">@Localizer["ExperienceRequired"]</th>
        <th class="text-center">@Localizer["Skins"]</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var patent in Model.Patents.OrderByDescending(p => p.Level))
    {
        var skins = Model.SkinsOf(patent.Level);

        <tr>
            <td class="text-center vertical-align-middle">#@patent.Level</td>
            <td class="vertical-align-middle slim">
                <img src="@patent.Image" alt="@patent.FullName" data-toggle="tooltip" data-placement="top" title="@patent.FullName" style="width: 48px"/>
            </td>
            <td class="vertical-align-middle">
                @patent.Name
            </td>
            <td class="text-center vertical-align-middle">
                @($"{patent.Experience:N0}")
            </td>
            <td class="text-center vertical-align-middle slim">
                @if (skins.Count > 0)
                {
                    <button type="button" class="btn btn-default btn-sm patent-skins-button" onclick="$('#patent-skins-@patent.Level').toggle()">
                        <span class="glyphicon glyphicon-th"></span> @string.Format(Localizer["ShowSkins"].Value, skins.Count)
                    </button>
                }
            </td>
        </tr>
        @if (skins.Count > 0)
        {
            <tr id="patent-skins-@patent.Level" style="display: none">
                <td colspan="5">
                    <p class="patent-skins-title">@string.Format(Localizer["SkinsUnlockedAtLevel"].Value, patent.Name)</p>
                    <div class="patent-skins">
                        @foreach (var skin in skins)
                        {
                            <a class="patent-skin @(skin.IsReleased ? "" : "patent-skin-soon")" href="@Url.Action("Index", "Skins")#level-@patent.Level" title="@skin.Title.Get(CultureInfo.CurrentUICulture)">
                                <img src="@skin.Image" alt="@skin.Title.Get(CultureInfo.CurrentUICulture)" loading="lazy"/>
                                <span>@skin.Title.Get(CultureInfo.CurrentUICulture)</span>
                                @if (!skin.IsReleased)
                                {
                                    <span class="patent-skin-release">@string.Format(Localizer["ComingSoonOn"].Value, skin.ReleaseDate.ToString("d", CultureInfo.CurrentUICulture))</span>
                                }
                            </a>
                        }
                    </div>
                    <a class="btn btn-default btn-sm patent-skins-button" href="@Url.Action("Index", "Skins")#level-@patent.Level">@Localizer["SeeAllSkins"]</a>
                </td>
            </tr>
        }
    }
    </tbody>
</table>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">@Localizer["XPBreakdownTitle"]</h3>
    </div>
    <div class="panel-body">
        <ul>
            <li>@string.Format(Localizer["VictoryXPPoints"].Value, Model.Config.Win)</li>
            <li>@string.Format(Localizer["DefeatXPPoints"].Value, Model.Config.Loss)</li>
            <li>@string.Format(Localizer["MVPSIPoints"].Value, Model.Config.Mvps)</li>
            <li>@string.Format(Localizer["MVPCIPoints"].Value, Model.Config.MvpsCommon)</li>
            <li>@string.Format(Localizer["RageQuitXPPoints"].Value, Model.Config.RageQuit)</li>
        </ul>
    </div>
</div>