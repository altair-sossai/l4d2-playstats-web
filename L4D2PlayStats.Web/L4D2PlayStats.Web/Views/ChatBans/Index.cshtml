@using System.Globalization
@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.Models
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Web.Models.ChatBansModel
@inject IViewLocalizer Localizer
@inject IStringLocalizer<SharedResource> SharedLocalizer

@{
    ViewData["Title"] = SharedLocalizer["ChatBans"].Value;
    var culture = CultureInfo.CurrentUICulture;
    var pagination = PaginationModel.Of(Model.Bans, number => Url.Action("Index", "ChatBans", new { q = Model.Query, page = number })!);
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    <style>
        .cb-reason {
            display: -webkit-box !important;
            overflow: hidden;
            white-space: normal !important;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        .cb-details-avatar {
            width: 96px !important;
            height: 96px !important;
            border-radius: 50% !important;
        }
    </style>
}

<div class="admin-header">
    <h3>@SharedLocalizer["ChatBans"]</h3>
    <button type="button" class="btn btn-primary cb-add">
        <span class="glyphicon glyphicon-plus"></span> @SharedLocalizer["AddBan"]
    </button>
</div>

<p class="text-muted">@Localizer["Lead"]</p>

<div class="admin-stats">
    <div>
        <strong>@Model.TotalBans.ToString("N0", culture)</strong>
        <small>@Localizer["StatBans"]</small>
    </div>
</div>

<form method="get" class="admin-filters">
    <input type="text" name="q" value="@Model.Query" class="form-control admin-search" placeholder="@Localizer["SearchPlaceholder"]"/>
    <button type="submit" class="btn btn-default"><span class="glyphicon glyphicon-search"></span> @SharedLocalizer["Search"]</button>
    @if (!string.IsNullOrEmpty(Model.Query))
    {
        <a class="btn btn-link" href="@Url.Action("Index", "ChatBans")">@Localizer["ClearFilters"]</a>
    }
</form>

<div class="admin-list">
    @if (Model.Bans.Items.Count == 0)
    {
        <div class="admin-empty">@SharedLocalizer["NoChatBansFound"]</div>
    }
    @foreach (var ban in Model.Bans.Items)
    {
        var name = string.IsNullOrWhiteSpace(ban.Name) ? ban.CommunityId : ban.Name;
        var bannedAt = ban.CreatedAtUtc.ToLocalTime().ToString("g", culture);
        var updatedAt = ban.UpdatedAtUtc?.ToLocalTime().ToString("g", culture);

        <div class="admin-item cb-ban"
             data-community-id="@ban.CommunityId" data-name="@name" data-avatar="@ban.AvatarUrl" data-steam-id="@ban.SteamId"
             data-profile-url="@ban.ProfileUrl" data-reason="@ban.Reason" data-banned-at="@bannedAt" data-updated-at="@updatedAt"
             data-banned-by="@ban.CreatedByName">
            <img class="admin-avatar" src="@ban.AvatarUrl" alt="@name" onerror="imgOnError(this)"/>
            <div class="admin-main">
                <div class="admin-title">@name</div>
                <small>@ban.SteamId · @ban.CommunityId</small>
                <small class="cb-reason">@(string.IsNullOrWhiteSpace(ban.Reason) ? Localizer["NoReason"].Value : ban.Reason)</small>
            </div>
            <div class="admin-side">
                <strong>@bannedAt</strong>
                @if (!string.IsNullOrWhiteSpace(ban.CreatedByName))
                {
                    <small>@string.Format(Localizer["BannedByValue"].Value, ban.CreatedByName)</small>
                }
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("_Pagination", pagination)

<div id="cb-details-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@SharedLocalizer["Close"]"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">@Localizer["BanDetails"]</h4>
            </div>
            <div class="modal-body">
                <div class="admin-details">
                    <img class="cb-avatar cb-details-avatar" src="" alt="" onerror="imgOnError(this)"/>
                    <dl>
                        <dt>@SharedLocalizer["Player"]</dt>
                        <dd>
                            <a class="cb-player-link" href="#"></a><br/>
                            <small class="cb-ids text-muted"></small><br/>
                            <a class="cb-steam-link" href="#" target="_blank" rel="noopener noreferrer">@Localizer["SteamProfile"]</a>
                        </dd>
                        <dt>@SharedLocalizer["BanDate"]</dt>
                        <dd class="cb-banned-at"></dd>
                        <dt class="cb-updated-at-label">@Localizer["UpdatedAt"]</dt>
                        <dd class="cb-updated-at"></dd>
                        <dt class="cb-banned-by-label">@Localizer["BannedBy"]</dt>
                        <dd class="cb-banned-by"></dd>
                    </dl>
                </div>
                <div class="form-group">
                    <label for="cb-details-reason">@SharedLocalizer["Reason"]</label>
                    <textarea id="cb-details-reason" class="form-control" rows="3"></textarea>
                </div>
                <div class="alert alert-warning admin-confirm cb-remove-confirm">@SharedLocalizer["ConfirmDeleteChatBan"]</div>
                <div class="cb-message"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@SharedLocalizer["Close"]</button>
                <button type="button" class="btn btn-danger cb-remove"><span class="glyphicon glyphicon-trash"></span> @Localizer["RemoveBan"]</button>
                <button type="button" class="btn btn-danger cb-remove-yes" style="display: none">@Localizer["ConfirmRemoveButton"]</button>
                <button type="button" class="btn btn-primary cb-save-reason">@Localizer["SaveReason"]</button>
            </div>
        </div>
    </div>
</div>

<div id="cb-add-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="@SharedLocalizer["Close"]"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">@SharedLocalizer["AddBan"]</h4>
            </div>
            <div class="modal-body">
                <input type="hidden" id="cb-add-name"/>
                <div class="form-group">
                    <label for="cb-add-player">@SharedLocalizer["SteamIdOrProfileUrl"]</label>
                    <input type="text" id="cb-add-player" class="form-control" placeholder="76561198000000000"/>
                </div>
                <div class="form-group">
                    <label for="cb-add-reason">@SharedLocalizer["Reason"]</label>
                    <textarea id="cb-add-reason" class="form-control" rows="2"></textarea>
                </div>
                <label>@SharedLocalizer["RecentSenders"]</label>
                <div class="list-group cb-recent" style="max-height: 240px; overflow-y: auto"></div>
                <div class="cb-add-message"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">@SharedLocalizer["Cancel"]</button>
                <button type="button" class="btn btn-primary cb-add-save">@SharedLocalizer["Save"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var texts = {
                required: @Json.Serialize(SharedLocalizer["SteamIdOrProfileUrl"].Value),
                saved: @Json.Serialize(Localizer["Saved"].Value),
                removed: @Json.Serialize(Localizer["Removed"].Value),
                noRecent: @Json.Serialize(Localizer["NoRecentSenders"].Value),
                alreadyBanned: @Json.Serialize(Localizer["AlreadyBanned"].Value),
                error: @Json.Serialize(Localizer["ErrorGeneric"].Value)
            };

            var selected = null;

            function escapeHtml(text) {
                return $('<div/>').text(text == null ? '' : text).html();
            }

            function message($target, success, text) {
                $target.html('<div class="alert ' + (success ? 'alert-success' : 'alert-danger') + '">' + escapeHtml(text) + '</div>');
            }

            function errorText(xhr) {
                return (xhr.responseJSON && xhr.responseJSON.errorMessage) || texts.error;
            }

            function saveBan(communityId, name, reason) {
                return $.ajax({
                    url: '/api/chat-bans',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ communityId: communityId, name: name || null, reason: reason || null })
                });
            }

            $('.cb-ban').on('click', function () {
                var $item = $(this);
                var $modal = $('#cb-details-modal');
                var updatedAt = $item.data('updated-at');
                var bannedBy = $item.data('banned-by');
                var profileUrl = $item.data('profile-url');

                selected = { communityId: $item.data('community-id').toString(), name: $item.data('name') };

                $modal.find('.cb-avatar').attr({ src: $item.data('avatar'), alt: selected.name });
                $modal.find('.cb-player-link').text(selected.name).attr('href', '/player/' + encodeURIComponent(selected.communityId));
                $modal.find('.cb-ids').text(($item.data('steam-id') || '') + ' · ' + selected.communityId);
                $modal.find('.cb-steam-link').attr('href', profileUrl || '#').toggle(!!profileUrl);
                $modal.find('.cb-banned-at').text($item.data('banned-at'));
                $modal.find('.cb-updated-at').text(updatedAt || '');
                $modal.find('.cb-updated-at, .cb-updated-at-label').toggle(!!updatedAt);
                $modal.find('.cb-banned-by').text(bannedBy || '');
                $modal.find('.cb-banned-by, .cb-banned-by-label').toggle(!!bannedBy);
                $('#cb-details-reason').val($item.data('reason') || '');
                $modal.find('.cb-remove-confirm').hide();
                $modal.find('.cb-message').empty();
                $modal.find('.cb-remove').show();
                $modal.find('.cb-remove-yes').hide();
                $modal.find('button').prop('disabled', false);
                $modal.modal('show');
            });

            $('.cb-save-reason').on('click', function () {
                var $button = $(this);
                var $message = $('#cb-details-modal .cb-message');

                $button.prop('disabled', true);

                saveBan(selected.communityId, selected.name, $.trim($('#cb-details-reason').val())).done(function () {
                    message($message, true, texts.saved);
                    setTimeout(function () { location.reload(); }, 900);
                }).fail(function (xhr) {
                    message($message, false, errorText(xhr));
                    $button.prop('disabled', false);
                });
            });

            $('.cb-remove').on('click', function () {
                $('#cb-details-modal .cb-remove-confirm').show();
                $(this).hide();
                $('#cb-details-modal .cb-remove-yes').show();
            });

            $('.cb-remove-yes').on('click', function () {
                var $button = $(this);
                var $message = $('#cb-details-modal .cb-message');

                $button.prop('disabled', true);

                $.ajax({
                    url: '/api/chat-bans/' + encodeURIComponent(selected.communityId),
                    type: 'DELETE'
                }).done(function () {
                    message($message, true, texts.removed);
                    setTimeout(function () { location.reload(); }, 900);
                }).fail(function (xhr) {
                    message($message, false, errorText(xhr));
                    $button.prop('disabled', false);
                });
            });

            function loadRecentSenders() {
                var $list = $('#cb-add-modal .cb-recent').empty();

                $.getJSON('/api/chat-bans/recent-senders').done(function (senders) {
                    if (!senders || senders.length === 0) {
                        $list.append('<div class="list-group-item text-muted">' + escapeHtml(texts.noRecent) + '</div>');
                        return;
                    }

                    $.each(senders, function (index, sender) {
                        var $item = $('<a href="#" class="list-group-item"></a>');

                        $item.append('<img src="' + escapeHtml(sender.avatarUrl) + '" alt="" style="width: 24px; border-radius: 50%; margin-right: 8px" onerror="imgOnError(this)"/>');
                        $item.append($('<strong></strong>').text(sender.name || sender.communityId));

                        if (sender.alreadyBanned) {
                            $item.addClass('disabled');
                            $item.append(' <span class="label label-default">' + escapeHtml(texts.alreadyBanned) + '</span>');
                        }

                        $item.append($('<div class="text-muted small"></div>').text(sender.message));

                        $item.on('click', function (event) {
                            event.preventDefault();

                            if (sender.alreadyBanned)
                                return;

                            $('#cb-add-player').val(sender.communityId);
                            $('#cb-add-name').val(sender.name || '');
                            $('#cb-add-reason').focus();
                        });

                        $list.append($item);
                    });
                });
            }

            $('.cb-add').on('click', function () {
                $('#cb-add-player').val('');
                $('#cb-add-name').val('');
                $('#cb-add-reason').val('');
                $('#cb-add-modal .cb-add-message').empty();
                $('#cb-add-modal .cb-add-save').prop('disabled', false);
                loadRecentSenders();
                $('#cb-add-modal').modal('show');
            });

            $('.cb-add-save').on('click', function () {
                var $button = $(this);
                var $message = $('#cb-add-modal .cb-add-message');
                var player = $.trim($('#cb-add-player').val());

                if (player === '') {
                    message($message, false, texts.required);
                    return;
                }

                $button.prop('disabled', true);

                saveBan(player, $('#cb-add-name').val(), $.trim($('#cb-add-reason').val())).done(function () {
                    message($message, true, texts.saved);
                    setTimeout(function () { location.reload(); }, 900);
                }).fail(function (xhr) {
                    message($message, false, errorText(xhr));
                    $button.prop('disabled', false);
                });
            });
        });
    </script>
}
