@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.Extensions
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Core.GameInfo.Models.Events.RoundLiveEvent
@inject IStringLocalizer<SharedResource> Localizer

@{
    var roundText = Localizer[Model.SecondHalf ? "GameEventSecondRound" : "GameEventFirstRound"].Value;
    var round = Html.EventSpan("game-event-highlight", roundText);
    var live = Html.EventSpan("game-event-action", Localizer["GameEventLive"].Value);
}

@Html.EventFormat(Localizer["GameEventRoundIsLive"].Value, round, live)