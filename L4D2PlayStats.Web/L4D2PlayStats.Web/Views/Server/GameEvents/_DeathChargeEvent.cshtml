@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.Extensions
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Core.GameInfo.Models.Events.DeathChargeEvent
@inject IStringLocalizer<SharedResource> Localizer

@{
    var height = (int)Math.Round(Model.Height);
}

<span class="game-event-stars">@Model.StarsText</span>
@(Html.EventPlayer(Model.Actor, Localizer["GameEventCharger"]))
<span class="game-event-danger">@Localizer["GameEventDeathCharged"]</span>
@(Html.EventPlayer(Model.Victim, Localizer["GameEventSurvivor"]))
@if (!Model.WasCarried)
{
    <text>@Localizer["GameEventByBowling"]</text>
}
(@Html.EventStat(Localizer["GameEventHeight"].Value, height)).