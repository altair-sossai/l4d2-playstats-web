@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.Extensions
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Core.GameInfo.Models.Events.TankBecameBotEvent
@inject IStringLocalizer<SharedResource> Localizer

@if (Model.Actor != null)
{
    @(Html.EventPlayer(Model.Actor, Localizer["GameEventTank"]))
    <text> @Localizer["GameEventLostTankToAi"].</text>
}
else
{
    <text>@Localizer["GameEventTankBecameBot"].</text>
}