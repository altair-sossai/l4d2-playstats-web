@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.Extensions
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Core.GameInfo.Models.Events.WitchCrownEvent
@inject IStringLocalizer<SharedResource> Localizer

<span class="game-event-stars">@Model.StarsText</span>
@(Html.EventPlayer(Model.Actor!))
<span class="game-event-action">@Localizer["GameEventCrownedWitch"]</span>
(<span class="game-event-danger">@Localizer["GameEventDamage", Model.Damage]</span>).