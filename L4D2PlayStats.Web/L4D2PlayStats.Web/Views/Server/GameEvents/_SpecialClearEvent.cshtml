@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.Extensions
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Core.GameInfo.Models.Events.SpecialClearEvent
@inject IStringLocalizer<SharedResource> Localizer

<span class="game-event-stars">@Model.StarsText</span>
@(Html.EventPlayer(Model.Actor, Localizer["GameEventUnknownPlayer"]))
<span class="game-event-action">@Localizer["GameEventInstaCleared"]</span>
@(Html.EventPlayer(Model.PinVictim, Localizer["GameEventTeammate"]))
@Localizer["GameEventFrom"]
@(Html.EventPlayer(Model.Pinner, Localizer[$"GameEvent{Model.ZombieClass}"]))
(@Html.EventStat(Localizer["GameEventSeconds"].Value, Model.ClearTime.ToString("N2"))).