@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.Extensions
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Core.GameInfo.Models.Events.ChargerLevelHurtEvent
@inject IStringLocalizer<SharedResource> Localizer

<span class="game-event-stars">@Model.StarsText</span>
@(Html.EventPlayer(Model.Actor, Localizer["GameEventUnknownPlayer"]))
<span class="game-event-action">@Localizer["GameEventChipLeveled"]</span>
@(Html.EventPlayer(Model.Charger, Localizer["GameEventCharger"]))
(<span class="game-event-danger">@Localizer["GameEventDamage", Model.Damage]</span>).