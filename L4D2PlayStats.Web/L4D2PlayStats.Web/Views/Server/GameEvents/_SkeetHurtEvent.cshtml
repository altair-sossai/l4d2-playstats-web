@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.Extensions
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Core.GameInfo.Models.Events.SkeetHurtEvent
@inject IStringLocalizer<SharedResource> Localizer

<span class="game-event-stars">@Model.StarsText</span>
@(Html.EventPlayer(Model.Actor, Localizer["GameEventUnknownPlayer"]))
<span class="game-event-action">@Localizer["GameEventSkeeted"]</span>
@(Html.EventPlayer(Model.Hunter, Localizer["GameEventHunter"]))
(@Localizer["GameEventChippedHunter"], <span class="game-event-danger">@Localizer["GameEventDamage", Model.Damage]</span>).

@if (Model.IsOverkill)
{
    <text> @Localizer["GameEventWouldHaveSkeeted"]</text>
}
