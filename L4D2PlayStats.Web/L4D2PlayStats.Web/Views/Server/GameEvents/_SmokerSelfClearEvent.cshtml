@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.Extensions
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Core.GameInfo.Models.Events.SmokerSelfClearEvent
@inject IStringLocalizer<SharedResource> Localizer

<span class="game-event-stars">@Model.StarsText</span>
@(Html.EventPlayer(Model.Actor, Localizer["GameEventUnknownPlayer"]))
<span class="game-event-action">@Localizer["GameEventSelfCleared"]</span>
@(Html.EventPlayer(Model.Smoker, Localizer["GameEventSmoker"]))
@if (Model.WithShove)
{
    <text> @Localizer["GameEventByShoving"]</text>
}
<text>.</text>