@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.Extensions
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Core.GameInfo.Models.Events.RoundEndedEvent
@inject IStringLocalizer<SharedResource> Localizer

@{
    var survivor = Html.EventSpan("game-event-highlight", Model.SurvivorScore.ToString());
    var infected = Html.EventSpan("game-event-highlight", Model.InfectedScore.ToString());
    var difference = Html.EventSpan("game-event-action", Model.Difference.ToString());
}

@Localizer["GameEventRoundEnded"] (@Html.EventFormat(Localizer["GameEventScore"].Value, survivor, infected)) - @Html.EventFormat(Localizer["GameEventScoreDifference"].Value, difference).