@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.Extensions
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Core.GameInfo.Models.Events.BunnyHopStreakEvent
@inject IStringLocalizer<SharedResource> Localizer

@{
    var velocity = (int)Math.Round(Model.MaxVelocity);
}

<span class="game-event-stars">@Model.StarsText</span>
@(Html.EventPlayer(Model.Actor, Localizer["GameEventUnknownPlayer"]))
<span class="game-event-action">@Localizer["GameEventLanded"]</span>
<span class="game-event-highlight">@Localizer["GameEventBunnyHops", Model.Streak]</span>
<span class="game-event-highlight">(@Localizer["GameEventMaxVelocity", velocity])</span>.