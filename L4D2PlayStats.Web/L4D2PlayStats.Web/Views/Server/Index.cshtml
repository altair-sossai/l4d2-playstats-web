@using L4D2PlayStats.Core.Auth
@using L4D2PlayStats.Core.Campaign.Contracts
@using L4D2PlayStats.Web
@using L4D2PlayStats.Web.PageMetadata
@using Microsoft.Extensions.Localization
@model L4D2PlayStats.Web.Models.ServerInfoModel

@inject IStringLocalizer<SharedResource> SharedLocalizer
@inject ICurrentUser CurrentUser
@inject ICampaignName CampaignName
@inject ICampaignThumb CampaignThumb

@{
    ViewData["PageMetadata"] = new ServerPageMetadata(Model, SharedLocalizer, CampaignName, CampaignThumb);
}

@section Styles {
    <style>
        .table-survivors,
        .table-infecteds {
            width: 100%;
        }

            .table-survivors .img-character,
            .table-infecteds .img-infected {
                margin: 0;
                padding: 0;
            }

            .table-survivors .img-avatar,
            .table-infecteds .img-avatar {
                padding-right: 5px;
            }

            .table-survivors .img-weapon {
                display: inline-block;
                height: 15px;
                padding-right: 5px;
                margin-bottom: 5px;
            }

            .table-survivors .progress,
            .table-infecteds .progress {
                margin-bottom: 0;
                border-radius: 0;
            }

            .table-survivors .table-hp-progress,
            .table-infecteds .table-hp {
                width: 100%;
                margin-bottom: 5px;
                white-space: nowrap;
            }

                .table-survivors .table-hp-progress .progress,
                .table-infecteds .table-hp .progress {
                    height: 12px;
                }

                .table-survivors .table-hp-progress .hp-progress-number,
                .table-infecteds .table-hp .hp-number {
                    padding: 0;
                    margin: 0;
                    padding-left: 10px;
                    font-size: 11px;
                    text-align: center;
                }

            .table-survivors hr,
            .table-infecteds hr {
                margin: 0px 0px 5px 0;
            }

        .temporary {
            opacity: 0.5;
        }

        .img-latency {
            display: inline-block;
            height: 16px;
        }

        .img-gray {
            -webkit-filter: grayscale(100%);
            filter: grayscale(100%);
        }

        .td-latency {
            width: 40px;
        }

        .row-players .panel-body {
            padding: 5px;
        }

        #feed {
            height: 400px;
            overflow-x: hidden;
            overflow-y: auto;
            padding-right: 10px;
        }

        .feed-heading {
            display: table;
            width: 100%;
        }

            .feed-heading > * {
                display: table-cell;
                vertical-align: middle;
            }

            .feed-heading > .dropdown {
                text-align: right;
            }

        .game-event-stars,
        .game-event-highlight {
            color: #5cb85c;
            font-weight: bold;
        }

        .game-event-player {
            color: #9b873c;
            font-weight: bold;
        }

        .game-event-action {
            color: #5bc0de;
            font-weight: bold;
        }

        .game-event-danger {
            color: #d9534f;
            font-weight: bold;
        }

        .live-event-carousel {
            display: none;
        }

        .live-event-carousel.is-visible {
            display: flex;
            align-items: center;
            min-height: 44px;
            margin: -10px 0 20px;
            padding: 9px 12px;
            overflow: hidden;
            background-color: rgba(92, 184, 92, 0.1);
            border-left: 3px solid #5cb85c;
            border-radius: 2px;
        }

        .live-event-indicator {
            flex: 0 0 auto;
            width: 8px;
            height: 8px;
            margin-right: 10px;
            background-color: #5cb85c;
            border-radius: 50%;
            box-shadow: 0 0 0 rgba(92, 184, 92, 0.45);
            animation: live-event-pulse 2s infinite;
        }

        .live-event-content {
            min-width: 0;
            line-height: 1.45;
            opacity: 1;
            transform: translateY(0);
            transition: opacity 250ms ease, transform 250ms ease;
        }

        .live-event-content.is-leaving {
            opacity: 0;
            transform: translateY(-7px);
        }

        .live-event-content.is-entering {
            opacity: 0;
            transform: translateY(7px);
            transition: none;
        }

        @@keyframes live-event-pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(92, 184, 92, 0.45);
            }

            70% {
                box-shadow: 0 0 0 7px rgba(92, 184, 92, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(92, 184, 92, 0);
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .live-event-indicator {
                animation: none;
            }

            .live-event-content {
                transition: none;
            }
        }

        .spectators a {
            margin-left: 8px;
        }

        #command-container {
            text-align: center;
            margin: 8px 0;
        }

        #commands {
            max-height: 75vh;
            overflow-y: auto;
        }

        #commands h5 {
            margin: 0;
        }
    </style>
}

@section Scripts {
    <script>
        var refreshInterval = 2600;
        var maxFeedItems = 300;
        var feedRefreshTimer = null;
        var feedRefreshRequest = null;
        var feedRefreshPending = false;
        var dd = new diffDOM.DiffDOM();
        var liveEventCarousel = {
            selector: '#live-event-carousel',
            queue: [],
            seen: {},
            seenOrder: [],
            displayTimer: null,
            hideTimer: null,
            transitioning: false,
            displayDuration: 4500,
            idleDuration: 15000,
            initialEventMaxAge: 30000,
            maxSeen: 500,
            serverNowTicks: Number('@DateTime.UtcNow.Ticks'),
            transitionDuration: 250,

            preserveDuring: function (callback) {
                var carousel = $(this.selector).detach();
                callback();

                if (carousel.length)
                    $(this.selector).replaceWith(carousel);
            },

            initialize: function () {
                var latestEvent = this.read($('#feed p[data-feed-kind="event"]').last());

                if (!latestEvent)
                    return;

                this.remember(latestEvent.when);

                if (!this.isRecent(latestEvent))
                    return;

                this.show(latestEvent, false);
            },

            enqueue: function (events) {
                var carousel = this;
                var added = false;

                events.each(function () {
                    var event = carousel.read(this);

                    if (!event || !carousel.remember(event.when))
                        return;

                    carousel.queue.push(event);
                    added = true;
                });

                if (!added)
                    return;

                clearTimeout(this.hideTimer);
                this.hideTimer = null;

                if (this.queue.length && !this.displayTimer && !this.transitioning)
                    this.next();
            },

            read: function (element) {
                var event = $(element);
                var when = event.attr('data-feed-when');

                if (!when)
                    return null;

                return {
                    when: String(when),
                    html: event.html()
                };
            },

            isRecent: function (event) {
                var ageTicks = this.serverNowTicks - Number(event.when);
                return ageTicks >= 0 && ageTicks <= this.initialEventMaxAge * 10000;
            },

            remember: function (when) {
                if (this.seen[when])
                    return false;

                this.seen[when] = true;
                this.seenOrder.push(when);

                if (this.seenOrder.length > this.maxSeen)
                    delete this.seen[this.seenOrder.shift()];

                return true;
            },

            next: function () {
                this.displayTimer = null;

                if (this.queue.length)
                    this.show(this.queue.shift(), true);
            },

            scheduleHide: function () {
                clearTimeout(this.hideTimer);
                this.hideTimer = setTimeout(this.hide.bind(this), this.idleDuration);
            },

            hide: function () {
                var carousel = this;
                var container = $(this.selector);
                var content = container.find('.live-event-content');
                this.hideTimer = null;

                if (!container.hasClass('is-visible'))
                    return;

                this.transitioning = true;
                content.addClass('is-leaving');

                setTimeout(function () {
                    container.removeClass('is-visible');
                    content.empty().removeClass('is-leaving');
                    carousel.transitioning = false;

                    if (carousel.queue.length)
                        carousel.next();
                }, this.transitionDuration);
            },

            show: function (event, animate) {
                var carousel = this;
                var container = $(this.selector);
                var content = container.find('.live-event-content');
                this.transitioning = true;

                function replaceContent() {
                    content.html(event.html).removeClass('is-leaving is-entering');

                    if (animate) {
                        content.addClass('is-entering');
                        content[0].offsetHeight;
                        content.removeClass('is-entering');
                    }

                    container.addClass('is-visible');
                    carousel.transitioning = false;

                    if (carousel.queue.length) {
                        carousel.displayTimer = setTimeout(carousel.next.bind(carousel), carousel.displayDuration);
                    } else {
                        carousel.scheduleHide();
                    }
                }

                if (animate && container.hasClass('is-visible')) {
                    content.addClass('is-leaving');
                    setTimeout(replaceContent, this.transitionDuration);
                } else {
                    replaceContent();
                }
            }
        };

        function sync(current, html) {
            var source = document.createElement('div');
            source.id = current.id;
            source.innerHTML = html;

            var diffs = dd.diff(current, source);
            dd.apply(current, diffs);
        }

        function loadCampaigns() {
            $.ajax({
                url: '/api/campaigns',
                method: 'GET',
                dataType: 'json',
                success: function (campaigns) {
                    terminal.dataSources.campaign.items = function() {
                        return $.map(campaigns, function(campaign) {
                            return { displayText: campaign.name, value: campaign.maps[0] };
                        });
                    };
                }
            });
        }

        function refreshHeader() {
            $.ajax({
                url: '/server/header',
                type: 'GET',
                timeout: 2000,
                success: function (html) {
                    var target = document.getElementById('game-info-header');
                    sync(target, html);

                },
                complete: function () {
                    setTimeout(refreshHeader, refreshInterval);
                }
            });
        }

        function refreshPlayers() {
            $.ajax({
                url: '/server/players',
                type: 'GET',
                timeout: 2000,
                success: function (html) {
                    var target = document.getElementById('game-info-players');
                    liveEventCarousel.preserveDuring(function () {
                        sync(target, html);
                    });
                },
                complete: function () {
                    setTimeout(refreshPlayers, refreshInterval);
                }
            });
        }

        function applyFeedFilter() {
            var mode = 'all';

            try { 
                mode = localStorage.getItem('feedFilter') || 'all'; 
            } catch (err) {
                console.warn('Unable to access localStorage:', err);
            }

            $('#feed p[data-feed-kind]').each(function () {
                var kind = $(this).attr('data-feed-kind');
                var show = mode === 'all'
                    || (mode === 'events' && kind === 'event')
                    || (mode === 'messages' && kind === 'message');
                $(this).toggle(show);
            });
        }

        function refreshFeed() {
            clearTimeout(feedRefreshTimer);
            feedRefreshTimer = null;

            if (feedRefreshRequest) {
                feedRefreshPending = true;
                return;
            }

            feedRefreshPending = false;
            var after = $('#feed p[data-feed-when]').last().data('feed-when') || 0;

            feedRefreshRequest = $.ajax({
                url: '/server/feed?after=' + after,
                type: 'GET',
                timeout: 2000,
                success: function (html, status) {
                    if (!html || status == "nocontent")
                        return;

                    var feed = $('#feed');
                    var newEvents = $('<div>').html(html).find('p[data-feed-kind="event"]');
                    var scrollDown = feed[0].scrollHeight - feed.scrollTop() === feed.outerHeight();

                    feed.append(html);

                    $('#feed p[data-feed-when]').each(function () {
                        var feedWhen = $(this).data('feed-when');
                        if (feedWhen) {
                            var $duplicates = $('#feed p[data-feed-when="' + feedWhen + '"]').slice(1);
                            $duplicates.remove();
                        }
                    });

                    var $items = $('#feed p[data-feed-when]');
                    if ($items.length > maxFeedItems)
                        $items.slice(0, $items.length - maxFeedItems).remove();

                    applyFeedFilter();
                    liveEventCarousel.enqueue(newEvents);

                    if (scrollDown)
                        feed.scrollTop(feed[0].scrollHeight);
                },
                complete: function () {
                    feedRefreshRequest = null;
                    feedRefreshTimer = setTimeout(refreshFeed, feedRefreshPending ? 0 : refreshInterval / 2);
                }
            });
        }

        function sendMessage() {
            var message = $('#message').val().trim();
            if (!message)
                return;

            $.ajax({
                url: '/api/external-chat',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ message: message }),
                success: function (result, statusCode) {
                    if (result?.success || statusCode == 'nocontent') {
                        refreshFeed();
                        $('#message').val('');
                        $('button[type="submit"]').prop('disabled', true);
                    } else {
                        alert(result?.errorMessage ?? statusCode);
                    }
                }
            });
        }

