                    }
                }
            },
            show: function() {
                this.path = [];
                this.build();
                $('#terminal').modal();
            },
            close: function() {
                $('#terminal').modal('hide');
            },
            previous: function() {
                if (!this.path.length) {
                    this.close();
                    return;
                }

                this.path.pop();
                this.build();
            },
            next: function(value) {
                this.path.push(value);
                this.build();
            },
            build: function() {
                var options = [];

                this.clearOptions();

                if (this.path.length == 0) {
                    this.addOption({ displayText: '@Html.Raw(SharedLocalizer["SelectCommand"])', header: true });

                    var commands = this.commands;
                    var keys = Object.keys(commands);

                    options = $.map(keys, function(command) {
                        return { value: command, description: commands[command].description };
                    });
                } else {
                    var command = this.commands[this.path[0]];

                    if (this.path.length == command.args.length + 1) {
                        this.updatePreview();
                        this.flush();
                        return;
                    }

                    var arg = command.args[this.path.length - 1];
                    var dataSource = this.dataSources[arg];
                    var items = dataSource.items();

                    this.addOption({ displayText: dataSource.title, header: true });

                    options = $.map(items, function(item) {
                        return isObject(item) ? item : { value: item };
                    });
                }

                for (var i = 0; i < options.length; i++) {
                    this.addOption(options[i], function (e) {
                        e.preventDefault();
                        terminal.next($(this).data('value'));
                    });
                }

                if (this.path.length) {
                    this.addOption({ displayText: '← @Html.Raw(SharedLocalizer["Back"])' }, function (e) {
                        e.preventDefault();
                        terminal.previous();
                    });
                }

                this.updatePreview();

                $("#commands").scrollTop(0);
            },
            clearOptions: function() {
                $('#commands').empty();
            },
            addOption: function(option, onClick) {

                var $item = onClick ? $('<a>', { href: '#' }) : $('<div>');

                $item.addClass('list-group-item');

                if (option.header) {
                    $item.addClass('active');
                }

                if (option.value)
                    $item.data('value', option.value);

                if (onClick)
                    $item.on('click', onClick);

                var $title = $('<h5>', {
                    class: 'list-group-item-heading',
                    text: option.displayText || option.value
                });

                $item.append($title);

                if (option.description) {
                    var $description = $('<small>', {
                        class: 'list-group-item-text',
                        text: option.description
                    });

                    $item.append($description);
                }

                $('#commands').append($item);
            },
            command: function() {
                var values = this.path || [];

                values = $.grep(values, function(value) {
                    return value != null;
                });

                values = $.map(values, function(value) {
                    return String(value).trim();
                });

                values = $.grep(values, function(value) {
                    return value != '';
                });

                values = $.map(values, function(value) {
                    if (value.includes(' '))
                        return '"' + value + '"';

                    return value;
                });

                return values.join(' ');
            },
            updatePreview: function() {
                var command = this.command();

                if (command) {
                    $("#command-container").show();
                    $("#command").text(this.command());
                } else {
                    $("#command-container").hide();
                }
            },
            flush: function() {
                var command = this.command();
                if (!command)
                    return;

                $('#message').val(command);
                $('button[type="submit"]').prop('disabled', false);

                if (!confirm('@Html.Raw(SharedLocalizer["ConfirmExecuteCommand"])' + '\n\n' + command)) {
                    this.previous();
                    return;
                }

                $("#chatForm").submit();
                this.close();
            }
        };

        $(document).ready(function () {
            refreshHeader();
            refreshPlayers();
            refreshFeed();
            loadCampaigns();

            var savedFilter = 'all';

            try { 
                savedFilter = localStorage.getItem('feedFilter') || 'all'; 
            } 
            catch (err) {
                console.warn('Unable to access localStorage:', err);
            }

            $('#feed-filter-label').text($('#feed-filter-menu a[data-filter="' + savedFilter + '"]').text());

            applyFeedFilter();
            liveEventCarousel.initialize();

            $('#feed').scrollTop($('#feed')[0].scrollHeight);

            $('#feed-filter-menu a').on('click', function (e) {
                e.preventDefault();

                var mode = $(this).data('filter');

                try {
                    localStorage.setItem('feedFilter', mode);
                } catch (err) {
                    console.warn('Unable to access localStorage:', err);
                }

                $('#feed-filter-label').text($(this).text());
                applyFeedFilter();
                $('#feed').scrollTop($('#feed')[0].scrollHeight);
            });

             $('#chatForm').on('submit', function () {
                sendMessage();
            });

             $('#message').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    sendMessage();
                }
            });

            $('#message').on('input', function() {
                var message = $('#message').val().trim();
                $('button[type="submit"]').prop('disabled', message.length === 0);
            });
        });
    </script>
}

<h4 class="text-center">@SharedLocalizer["Server"]</h4>

<div id="game-info-header">
    @await Html.PartialAsync("_Header", Model)
</div>

<div id="game-info-players">
    @await Html.PartialAsync("_Players", Model)
</div>

<div id="game-info-chat" class="row" style="margin-top: 20px; @(Model.AnyPlayerConnected ? string.Empty : "display: none")">
    <div class="col-md-6 col-sm-12">
        <div class="panel panel-default">
            <div class="panel-heading feed-heading">
                <span>@SharedLocalizer["ChatMessages"]</span>
                <div class="dropdown">
                    <button class="btn btn-default btn-sm dropdown-toggle" type="button" data-toggle="dropdown">
                        <span id="feed-filter-label">@SharedLocalizer["FeedFilterAll"]</span>
                        <span class="caret"></span>
                    </button>
                    <ul id="feed-filter-menu" class="dropdown-menu dropdown-menu-right">
                        <li>
                            <a href="#" data-filter="all">@SharedLocalizer["FeedFilterAll"]</a>
                        </li>
                        <li>
                            <a href="#" data-filter="events">@SharedLocalizer["FeedFilterEvents"]</a>
                        </li>
                        <li>
                            <a href="#" data-filter="messages">@SharedLocalizer["FeedFilterMessages"]</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="panel-body">
                <div id="feed" style="margin-bottom: 20px">
                    @await Html.PartialAsync("_Feed", Model.GameInfo.Feed)
                </div>
                @if (CurrentUser.IsAuthenticated)
                {
                    <form id="chatForm" class="form-inline" onsubmit="return false;">
                        <div class="input-group" style="width: 100%">
                            <input type="text" id="message" name="message" class="form-control" placeholder="@SharedLocalizer["TypeYourMessage"]"/>
                            @if (CurrentUser.IsAdmin)
                            {
                                <div class="input-group-btn">
                                    <button type="button" class="btn btn-info btn-block" onclick="terminal.show()">
                                        <img src="~/imgs/icons/terminal.png" alt="@SharedLocalizer["Terminal"]" class="icon" data-toggle="tooltip" data-placement="top" title="@SharedLocalizer["Terminal"]"/>
                                    </button>
                                </div>
                            }
                            <div class="input-group-btn">
                                <button type="submit" class="btn btn-primary btn-block" disabled>
                                    @SharedLocalizer["Send"]
                                </button>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="btn btn-default btn-block">
                        <img src="~/imgs/steam.png" alt="@SharedLocalizer["LoginWithSteam"]" title="@SharedLocalizer["LoginWithSteam"]" class="img-responsive img-header-icon">
                        @SharedLocalizer["ChatLoginRequiredMessage"]
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="row hide-mobile">
    <div class="col-md-12 text-center">
        <a href="@Url.Action("Index", "Connect")" class="btn btn-sm btn-primary" style="margin: 10px">
            connect @Model.ServerIp
        </a>
    </div>
</div>

<div id="terminal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body" style="padding: 0">
                <div id="command-container">
                    <small>@SharedLocalizer["Preview"]:</small>
                    <code id="command"></code>
                </div>
                <div id="commands" class="list-group" style="margin: 0"></div>
            </div>
        </div>
    </div>
</div>

@{
    var light = Context.Request.Cookies["theme"] == "light";
    var copyIcon = light ? "copy-light.png" : "copy-dark.png";
}

<div id="server-info-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@SharedLocalizer["ServerInfo"]</h4>
            </div>
            <div class="modal-body">
                <table class="table table-condensed">
                    <tbody>
                    <tr>
                        <th class="text-nowrap">
                            IP
                            <span class="label label-success" style="margin-left: 5px">@SharedLocalizer["Recommended"]</span>
                        </th>
                        <td class="line-break-anywhere">
                            <code>connect @Model.ServerIp</code>
                            <img src="~/imgs/icons/@copyIcon" alt="@SharedLocalizer["CopyText"]" class="icon-copy"
                                 data-toggle="popover" data-placement="top" data-content="@SharedLocalizer["TextCopied"]"
                                 onclick="copyTextToClipboard('connect @Model.ServerIp', this)"/>
                        </td>
                    </tr>
                    <tr>
                        <th class="text-nowrap">
                            DNS
                            <span class="label label-default" style="margin-left: 5px">@SharedLocalizer["Alternative"]</span>
                        </th>
                        <td class="line-break-anywhere">
                            <code>connect @Model.ServerDns</code>
                            <img src="~/imgs/icons/@copyIcon" alt="@SharedLocalizer["CopyText"]" class="icon-copy"
                                 data-toggle="popover" data-placement="top" data-content="@SharedLocalizer["TextCopied"]"
                                 onclick="copyTextToClipboard('connect @Model.ServerDns', this)"/>
                        </td>
                    </tr>
                    </tbody>
                </table>
                <p class="text-muted" style="margin-bottom: 0">
                    <small>@SharedLocalizer["WhyUseDns"]</small>
                </p>
            </div>
        </div>
    </div>
</div>